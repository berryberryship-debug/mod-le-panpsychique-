import numpy as np
import qutip as qt
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

print("=== V90 : INTÉGRATION QUANTIQUE (Zanardi) vs BURES ===", flush=True)

N_STEPS = 400
T_FINAL = 20.0
OMEGA = 1.0
THETA = np.pi / 3.0
COUPLING = 1.0

sx, sy, sz = qt.sigmax(), qt.sigmay(), qt.sigmaz()
I2 = qt.qeye(2)

def H_individual(phi):
    nx = np.sin(THETA) * np.cos(phi)
    ny = np.sin(THETA) * np.sin(phi)
    nz = np.cos(THETA)
    return 0.5 * OMEGA * (nx*sx + ny*sy + nz*sz)

def H_two_qubits(phi):
    H1 = qt.tensor(H_individual(phi), I2)
    H2 = qt.tensor(I2, H_individual(phi))
    H_int = COUPLING * (qt.tensor(sx, sx) + qt.tensor(sy, sy))
    return H1 + H2 + H_int

def ground_state_two(phi):
    energies, states = H_two_qubits(phi).eigenstates()
    return states[int(np.argmin(energies))]

def qii(rho):
    rho_A = rho.ptrace(0)
    rho_B = rho.ptrace(1)
    rho_prod = qt.tensor(rho_A, rho_B)
    return 0.5 * float((rho - rho_prod).norm("tr"))

def qmi(rho):
    S_AB = float(qt.entropy_vn(rho, base=2))
    S_A = float(qt.entropy_vn(rho.ptrace(0), base=2))
    S_B = float(qt.entropy_vn(rho.ptrace(1), base=2))
    return S_A + S_B - S_AB

def simulate(gamma):
    times = np.linspace(0.0, T_FINAL, N_STEPS + 1)
    def H_of_t(t, **kwargs):
        phi = 2.0 * np.pi * t / T_FINAL
        return H_two_qubits(phi)
    psi0 = ground_state_two(0.0)
    rho0 = psi0.proj()
    c_ops = []
    if gamma > 0:
        c_ops.append(np.sqrt(gamma/2.0) * qt.tensor(sz, I2))
        c_ops.append(np.sqrt(gamma/2.0) * qt.tensor(I2, sz))
    result = qt.mesolve(H_of_t, rho0, times, c_ops=c_ops,
                        options={"store_states": True, "atol": 1e-10, "rtol": 1e-9})
    return result.states

rhos_ideal = simulate(0.0)
rho_ideal = rhos_ideal[-1]

GAMMA_SWEEP = np.linspace(0.0, 0.5, 21)
qii_vals, qmi_vals, bures_vals, purities = [], [], [], []

for gamma in GAMMA_SWEEP:
    rhos = simulate(gamma)
    rho_final = rhos[-1]
    qii_vals.append(qii(rho_final))
    qmi_vals.append(qmi(rho_final))
    bures_vals.append(qt.fidelity(rho_final, rho_ideal))
    purities.append(float(np.real((rho_final * rho_final).tr())))

fig, axes = plt.subplots(1, 3, figsize=(16, 4.5))

axes[0].plot(GAMMA_SWEEP, purities, 'o-', color='#2ca02c')
axes[0].set_xlabel(r"\(\gamma\)")
axes[0].set_ylabel("Pureté")
axes[0].set_title("Plénitude (Pureté)")
axes[0].grid(alpha=0.3)

axes[1].plot(GAMMA_SWEEP, qii_vals, 'o-', color='#ff7f0e', label='QII')
axes[1].plot(GAMMA_SWEEP, qmi_vals, 's--', color='#d62728', label='QMI')
axes[1].set_xlabel(r"\(\gamma\)")
axes[1].set_ylabel("Information intégrée")
axes[1].set_title("Intégration quantique")
axes[1].legend()
axes[1].grid(alpha=0.3)

axes[2].plot(GAMMA_SWEEP, bures_vals, 'o-', color='#1f77b4')
axes[2].set_xlabel(r"\(\gamma\)")
axes[2].set_ylabel("Fidélité de Bures")
axes[2].set_title("Vacuité (Géométrie)")
axes[2].grid(alpha=0.3)

plt.tight_layout()
plt.savefig("v90_quantum_integration.png", dpi=150)
np.savez("v90_data.npz", gamma=GAMMA_SWEEP, purity=purities,
         qii=qii_vals, qmi=qmi_vals, bures=bures_vals)
